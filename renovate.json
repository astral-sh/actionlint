{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>astral-sh/renovate-config",
    "customManagers:githubActionsVersions"
  ],
  "forkProcessing": "enabled",
  "ignorePaths": ["**/node_modules/**", "**/vendor/**", "testdata/**"],
  "gomod": {
    "constraintsFiltering": "strict"
  },
  "packageRules": [
    {
      "description": "Keep zizmor and its action's supported version map together",
      "matchPackageNames": ["zizmorcore/zizmor", "zizmorcore/zizmor-action"],
      "groupName": "zizmor"
    }
  ]
}
